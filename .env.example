# PatchPilot configuration.
#
# Copy to .env and edit. Every value here is already the default, so an empty
# .env gives you a fully working offline system: the deterministic mock model,
# the local hash embedder, the in-process vector store and SQLite.
#
# Nothing in this file is required. No cloud account, API key or proprietary
# service is needed for local development. Never commit a real .env.

# ----------------------------------------------------------------- general
# production turns on the safe defaults below: the API refuses to start without
# API keys, the unisolated local sandbox is refused, and run requests can neither
# loosen the sandbox policy nor ingest paths on this host.
PATCHPILOT_ENVIRONMENT=local           # local | ci | production
PATCHPILOT_LOG_LEVEL=INFO
PATCHPILOT_LOG_JSON=true               # false for human-readable logs

# -------------------------------------------------------------------- auth
# Comma-separated keys accepted as `Authorization: Bearer <key>` or
# `X-API-Key: <key>` on /api/v1. Empty means the API is open (fine on your own
# machine only). Generate with: openssl rand -hex 32
# PATCHPILOT_API_KEYS=
# Production refuses to start without keys unless an authenticating reverse
# proxy guards the API and you say so here.
PATCHPILOT_ALLOW_UNAUTHENTICATED=false

# ----------------------------------------------------------------- storage
# SQLite by default. For PostgreSQL:
#   postgresql+psycopg://patchpilot:patchpilot@localhost:5432/patchpilot
PATCHPILOT_DATABASE_URL=sqlite+pysqlite:///./patchpilot.db
PATCHPILOT_DATA_DIR=.patchpilot        # workspaces, artifacts, clones, vectors
# Connection pool (PostgreSQL only).
PATCHPILOT_DATABASE_POOL_SIZE=10
PATCHPILOT_DATABASE_MAX_OVERFLOW=20
# Apply migrations at startup. Set false when several replicas start at once,
# and run `patchpilot db upgrade` as a release step instead.
PATCHPILOT_AUTO_MIGRATE=true

# ------------------------------------------------------------- vector store
# Leave PATCHPILOT_QDRANT_URL unset to use the local on-disk vector store.
# Docker Compose sets it to http://qdrant:6333 for the api service.
# PATCHPILOT_QDRANT_URL=http://localhost:6333
# PATCHPILOT_QDRANT_API_KEY=
PATCHPILOT_QDRANT_COLLECTION=patchpilot_chunks

# --------------------------------------------------------------- embeddings
# "hash" is local, deterministic and free. "openai" uses any OpenAI-compatible
# /embeddings endpoint, including a local one.
PATCHPILOT_EMBEDDING_PROVIDER=hash
PATCHPILOT_EMBEDDING_DIM=256
# PATCHPILOT_EMBEDDING_MODEL=text-embedding-3-small
# PATCHPILOT_EMBEDDING_BASE_URL=http://localhost:11434/v1
# PATCHPILOT_EMBEDDING_API_KEY=

# -------------------------------------------------------------- model access
# Models are named provider:model. mock:* are deterministic test doubles that
# need no network. Everything below is optional.
PATCHPILOT_DEFAULT_MODEL=mock:deterministic
PATCHPILOT_LLM_TIMEOUT_SECONDS=120
# Retries for rate limits (429), overload (5xx, 529) and dropped connections,
# with exponential backoff that honours Retry-After.
PATCHPILOT_LLM_MAX_RETRIES=3

# PATCHPILOT_OPENAI_API_KEY=sk-...
PATCHPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
# Point the same adapter at a local server to compare hosted and local models:
#   PATCHPILOT_OPENAI_BASE_URL=http://localhost:11434/v1   (then use ollama:<model>)

# PATCHPILOT_ANTHROPIC_API_KEY=sk-ant-...
PATCHPILOT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Override the built-in pricing snapshot with your own JSON file:
# PATCHPILOT_PRICING_FILE=./pricing.json

# ------------------------------------------------------------------- github
# Optional. Raises the API rate limit and allows private repositories. Pasting
# issue text into the run form always works without it.
# PATCHPILOT_GITHUB_TOKEN=ghp_...
PATCHPILOT_GITHUB_API_URL=https://api.github.com

# ------------------------------------------------------------------ sandbox
# auto prefers Docker and falls back to the unisolated local backend only when
# that is allowed. See docs/security.md before changing these.
PATCHPILOT_SANDBOX_BACKEND=auto        # auto | docker | local
PATCHPILOT_SANDBOX_IMAGE=python:3.12-slim-bookworm
PATCHPILOT_SANDBOX_CPUS=1.0
PATCHPILOT_SANDBOX_MEMORY_MB=1024
PATCHPILOT_SANDBOX_PIDS_LIMIT=256
PATCHPILOT_SANDBOX_TIMEOUT_SECONDS=180
PATCHPILOT_SANDBOX_NETWORK=none        # none | bridge (bridge lets patches reach the network)
PATCHPILOT_SANDBOX_MAX_OUTPUT_BYTES=64000
PATCHPILOT_SANDBOX_TMPFS_SIZE_MB=64
# Set to false on a shared machine to refuse the unisolated local backend.
PATCHPILOT_ALLOW_LOCAL_SANDBOX=true

# --------------------------------------------------------------- run policy
# The PATCHPILOT_SANDBOX_* values above are what a run gets by default. These
# are the most a single API request may ask for.
PATCHPILOT_SANDBOX_MAX_TIMEOUT_SECONDS=3600
PATCHPILOT_SANDBOX_MAX_MEMORY_MB=16384
PATCHPILOT_SANDBOX_MAX_CPUS=16
# May a request loosen the policy (network access, another image, a weaker
# backend, a bigger patch budget, writes to protected paths)? Unset: yes
# locally, no in production.
# PATCHPILOT_ALLOW_RUN_OVERRIDES=
# May a request name a directory on this host as its repository? Unset: yes
# locally, no in production. If allowed, confine it with the roots below.
# PATCHPILOT_ALLOW_LOCAL_REPOSITORIES=
# PATCHPILOT_LOCAL_REPOSITORY_ROOTS=/srv/repos,/home/me/code

# -------------------------------------------------------------------- agent
PATCHPILOT_MAX_REPAIR_ATTEMPTS=3        # default and hard cap for API requests
PATCHPILOT_MAX_PATCH_FILES=10
PATCHPILOT_MAX_PATCH_LINES=400
PATCHPILOT_ALLOW_PATCHING_HIDDEN_FILES=false
PATCHPILOT_RETRIEVAL_TOP_K=12
PATCHPILOT_RETRIEVAL_MAX_CONTEXT_CHARS=40000

# ----------------------------------------------------------------- indexing
PATCHPILOT_INDEX_MAX_FILE_BYTES=400000
PATCHPILOT_INDEX_MAX_FILES=5000

# ------------------------------------------------------------------ workers
# Run the worker inside the API process. Set false when `patchpilot worker`
# runs as its own process (any number of them may share one database).
PATCHPILOT_WORKER_ENABLED=true
PATCHPILOT_WORKER_CONCURRENCY=2
PATCHPILOT_WORKER_POLL_SECONDS=0.5
# A running job's lease: renewed every heartbeat; a job whose lease is older
# than this belongs to a dead worker and is requeued by a live one.
PATCHPILOT_WORKER_HEARTBEAT_SECONDS=10
PATCHPILOT_WORKER_LEASE_SECONDS=60
# Backpressure: new work gets a 503 while this many jobs are waiting.
PATCHPILOT_MAX_QUEUED_JOBS=200

# ---------------------------------------------------------------- retention
# Unset keeps everything. When set, workers delete finished runs, benchmarks,
# jobs and idle repository checkouts older than this many days.
# `patchpilot cleanup --older-than DAYS` does the same on demand.
# PATCHPILOT_RETENTION_DAYS=30
PATCHPILOT_RETENTION_INTERVAL_HOURS=6

# ----------------------------------------------------------------- frontend
PATCHPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
